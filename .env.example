# The canonical origin. Everything absolute on the site is built from it:
# og:image and og:url, the JSON-LD @ids, sitemap.xml, the Sitemap: line in
# robots.txt, and the host printed on the share card. Get it wrong and the
# share previews 404 while the site itself looks fine — so set it before the
# first deploy that anyone will see.
#
# Vercel or a custom domain: the full origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://saadislam.dev

# GitHub Pages project site only. Set BOTH of these together — the base path
# has to match the path already inside the site URL:
#   NEXT_PUBLIC_SITE_URL=https://saad7890-web.github.io/Portfolio
#   NEXT_PUBLIC_BASE_PATH=/Portfolio
# Leave unset for Vercel and for any custom domain served from its root.
# NEXT_PUBLIC_BASE_PATH=/Portfolio
